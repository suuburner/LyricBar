{"lyrics": {"syncType": "LINE_SYNCED", "lines": [{"startTimeMs": 15300.0, "words": "It's been a long, long time since", "endTimeMs": "0"}, {"startTimeMs": 17230.0, "words": "I've memorized your face", "endTimeMs": "0"}, {"startTimeMs": 19240.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 22050.0, "words": "It's been four hours now since", "endTimeMs": "0"}, {"startTimeMs": 23960.0, "words": "I've wandered through your place", "endTimeMs": "0"}, {"startTimeMs": 26190.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 28840.0, "words": "And when I sleep on your couch", "endTimeMs": "0"}, {"startTimeMs": 30450.0, "words": "I feel very safe", "endTimeMs": "0"}, {"startTimeMs": 33080.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 35750.0, "words": "And when you bring the blankets", "endTimeMs": "0"}, {"startTimeMs": 37900.0, "words": "I cover up my face", "endTimeMs": "0"}, {"startTimeMs": 39840.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 41110.0, "words": "I do love you", "endTimeMs": "0"}, {"startTimeMs": 47010.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 48030.0, "words": "I do love you", "endTimeMs": "0"}, {"startTimeMs": 53690.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 70090.0, "words": "And when you play guitar I listen", "endTimeMs": "0"}, {"startTimeMs": 72960.0, "words": "To the strings buzz", "endTimeMs": "0"}, {"startTimeMs": 74640.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 76890.0, "words": "The metal vibrates underneath", "endTimeMs": "0"}, {"startTimeMs": 79960.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 80630.0, "words": "Your fingers", "endTimeMs": "0"}, {"startTimeMs": 81270.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 83740.0, "words": "And when you crochet", "endTimeMs": "0"}, {"startTimeMs": 84880.0, "words": "I feel mesmerized and proud", "endTimeMs": "0"}, {"startTimeMs": 87900.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 90550.0, "words": "And don't say 'I love you'", "endTimeMs": "0"}, {"startTimeMs": 92610.0, "words": "With saying it out loud", "endTimeMs": "0"}, {"startTimeMs": 94840.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 96030.0, "words": "It's hard so I won't say it at all", "endTimeMs": "0"}, {"startTimeMs": 101130.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 104330.0, "words": "And I won't stay very long", "endTimeMs": "0"}, {"startTimeMs": 108370.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 109870.0, "words": "But you are the life I needed all along", "endTimeMs": "0"}, {"startTimeMs": 115800.0, "words": "I think of you as my brother", "endTimeMs": "0"}, {"startTimeMs": 119390.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 120360.0, "words": "Although that sounds dumb", "endTimeMs": "0"}, {"startTimeMs": 122530.0, "words": "", "endTimeMs": "0"}, {"startTimeMs": 123560.0, "words": "And words are futile devices", "endTimeMs": "0"}]}, "offset": 0}